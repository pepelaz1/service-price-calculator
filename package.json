{
  "name": "service-price-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "db:seed": "node --experimental-sqlite server/seed.mjs",
    "api": "node --experimental-sqlite server/local.mjs",
    "cf:db:local": "wrangler d1 migrations apply service-price-calculator --local",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-sqlite --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "wrangler": "^4.151.2"
  }
}
